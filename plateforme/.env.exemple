# Configuration de la plateforme AMAZONE COMP — copiez ce fichier en « .env » et remplissez.
# Règle R7 : aucune valeur réelle ne doit jamais être commitée (le fichier .env est ignoré par Git).

# --- Base de données (obligatoire) ---
PLATEFORME_BDD_URL=postgres://utilisateur:mot_de_passe@localhost:5432/amazone_plateforme

# Mot de passe de l'utilisateur PostgreSQL (utilisé par docker-compose.yml)
BDD_MOT_DE_PASSE=REMPLACER_PAR_UN_MOT_DE_PASSE_FORT

# --- Service HTTP ---
# Adresse d'écoute (défaut : 0.0.0.0:8080)
PLATEFORME_ADRESSE=0.0.0.0:8080

# --- Signature des licences (Ed25519) ---
# Clé privée : 32 octets en hexadécimal (64 caractères), JAMAIS commitée.
# Génération : python3 -c "import secrets; print(secrets.token_hex(32))"
# À renseigner SOIT ci-dessous, SOIT via PLATEFORME_FICHIER_CLE_PRIVEE (fichier hors dépôt).
PLATEFORME_CLE_PRIVEE_LICENCE=REMPLACER_PAR_64_CARACTERES_HEXADECIMAUX
# PLATEFORME_FICHIER_CLE_PRIVEE=/etc/amazone/cle_privee.hex
# La clé publique correspondante est affichée au démarrage du service : c'est celle à
# embarquer dans l'application (rotation des clés : docs/modules/plateforme.md).

# --- Courriels (codes de vérification, réinitialisation) ---
PLATEFORME_COURRIEL_EXPEDITEUR=ne-pas-repondre@votre-domaine.bj

# --- Licences ---
# Nombre de transferts de poste autorisés par an et par entreprise (défaut : 2)
PLATEFORME_TRANSFERTS_PAR_AN=2
